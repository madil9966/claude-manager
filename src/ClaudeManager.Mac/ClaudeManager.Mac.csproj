<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Claude Manager for macOS: a menu bar app (Avalonia). Built and packaged on macOS by
    tools/build-macos.sh (GitHub Actions: .github/workflows/release.yml).
    It also compiles and runs on Windows, but only in demo / self-test / screenshot mode (nothing is saved there).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeManager</AssemblyName>
    <RootNamespace>ClaudeManager.Mac</RootNamespace>
    <AssemblyTitle>Claude Manager for macOS (unofficial)</AssemblyTitle>
    <ApplicationIcon></ApplicationIcon>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same profile model as the Windows app (plain data, no Windows APIs). -->
    <Compile Include="..\ClaudeManager\Core\Models.cs" Link="Shared\Models.cs" />
    <AvaloniaResource Include="..\..\assets\app-256.png" Link="Assets\app-256.png" />
    <AvaloniaResource Include="..\..\assets\tray-mac.png" Link="Assets\tray-mac.png" />
  </ItemGroup>

</Project>
